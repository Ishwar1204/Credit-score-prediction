{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🌐 Run Web App (http://localhost:5000)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/web_app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1",
                "PORT": "5000"
            }
        },
        {
            "name": "💳 Run Interactive CLI (cli.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⚡ Run Batch Prediction (test.csv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/predict.py",
            "args": ["--file", "test.csv", "--output", "test_predictions.csv"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧠 Retrain Model (src/train.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
